    r = install(os.path.join(ctx.dir, "fresh"))
    expect(r.returncode == 0, "make install, all built: " + (r.stdout + r.stderr)[-400:])
    for when, what in (({"src": 30, "obj": 10, "server": 20}, "has changed since it was compiled"),
                       ({"src": 0, "obj": 30, "server": 20}, "did not finish")):
        times(**when)
        stale = os.path.join(ctx.dir, "stale")
        r = install(stale)
        expect(r.returncode != 0 and what in r.stdout + r.stderr,
               "make install with times %s: %s" % (when, (r.stdout + r.stderr)[-400:]))
        expect(not os.path.exists(stale), "make install put things in all the same")

    # The real tree: what is built goes in, under the names the script runs.
    # Where, said on the command line: PREFIX may be in the environment, or
    # come down from a make running this.
    dest = os.path.join(ctx.dir, "dest")
    r = subprocess.run(["make", "-C", TOP, "install", "DESTDIR=" + dest, "PREFIX=/usr/local"],
                       capture_output=True, text=True)
    expect(r.returncode == 0, "make install: " + (r.stdout + r.stderr)[-600:])
    bindir = os.path.join(dest, "usr", "local", "bin")
    for name in ("Xtightvnc", "tightvncserver", "tightvncpasswd"):
        expect(os.access(os.path.join(bindir, name), os.X_OK), "%s was not installed: %s" % (name, r.stdout))
        expect(os.path.exists(os.path.join(dest, "usr", "local", "share", "man", "man1", name + ".1")),
               "no manual page for " + name)

    # a home directory of its own, with a short name: the socket goes in it
    home = tempfile.mkdtemp(prefix="tvnc-")
    n = free_display()
    env = dict(os.environ, HOME=home, PATH=bindir + os.pathsep + os.environ.get("PATH", ""),
               XAUTHORITY=os.path.join(home, ".Xauthority"))
    env.pop("DISPLAY", None)
    started = False
    try:
