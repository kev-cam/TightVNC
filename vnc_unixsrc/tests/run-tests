        raise Skip("the server under test is not this tree's")

    # A source changed since it was compiled (a git pull), or a build that
    # stopped before the link: install says so and puts nothing in, instead
    # of the programs from before; a source nothing is compiled from does not
    # stop it.  Tried on a tree of stand-ins with this Makefile, so the real
    # one is not touched (it may be shared, or in use by another run).
    tree = os.path.join(ctx.dir, "tree")
    vnc = os.path.join(tree, "Xvnc", "programs", "Xserver", "hw", "vnc")
    os.makedirs(vnc)
    shutil.copy2(os.path.join(TOP, "Makefile"), tree)
    stand_ins = {"Xvnc/programs/Xserver/Xvnc": 0o755, "Xvnc/programs/Xserver/Xvnc.man": 0o644,
                 "vncserver": 0o755, "vncserver.man": 0o644}
    for name, mode in stand_ins.items():
        with open(os.path.join(tree, name), "w") as f:
            f.write("#!/bin/sh\n" if mode & 0o100 else ".TH STAND-IN 1\n")
        os.chmod(os.path.join(tree, name), mode)
    src, obj = os.path.join(vnc, "xpra.c"), os.path.join(vnc, "xpra.o")
    server = os.path.join(tree, "Xvnc", "programs", "Xserver", "Xvnc")
    for path in (src, obj):
        open(path, "w").close()
    t = time.time() - 100

    def times(**when):
        for path, at in ((src, when["src"]), (obj, when["obj"]), (server, when["server"])):
            os.utime(path, (t + at, t + at))

    def install(dest):
        return subprocess.run(["make", "-C", tree, "install", "DESTDIR=" + dest, "PREFIX=/usr/local"],
                              capture_output=True, text=True)

    times(src=0, obj=10, server=20)
