def test_window_manager(start, ctx):
    """under a window manager the application's window is shared, not the frame"""
    need("xterm", "xwininfo")
    srv = start()
    wm = None
    for cmd in WINDOW_MANAGERS:
        if not shutil.which(cmd[0]):
            continue
        p = srv.run(*cmd)
        time.sleep(1.5)
        if p.poll() is None:
            wm = cmd[0]
            break
    if not wm:
        raise Skip("no window manager that runs on this server")
    srv.run("xterm", "-geometry", "80x24+100+100", "-T", "managed", "-e", "sh", "-c", "ls -la /; sleep 60")
    srv.run("xterm", "-geometry", "80x24+200+160", "-T", "second", "-e", "sleep", "60")
    time.sleep(1.5)
    c = srv.client()
    c.attach()
    win = c.find(title="managed")
    expect(win, "%s: windows: %r" % (wm, list(c.windows.values())))
    expect((win.w, win.h) == (484, 316), "%s: the frame was shared, not the xterm: %r" % (wm, win))
    # the two overlap and are left where the window manager has them:
    # focusing one brings it to the front, whole
    for name in ("managed", "second", "managed"):
        w = c.find(title=name)
        expect(w, "%s: no window %r" % (wm, name))
        c.focus(w)
        c.settle()
        pixels_agree(srv, c, [w])


