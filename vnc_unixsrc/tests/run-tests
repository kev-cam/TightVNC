def test_wire_format(start, ctx):
    """xpra_wire.c on its own: known answers, round trips, damaged input"""
    cc = shutil.which("cc") or shutil.which("gcc")
    if not cc:
        raise Skip("no C compiler")
    exe = os.path.join(ctx.dir, "wire_test")
    base = [cc, "-std=gnu90", "-Wall", "-g", "-O1", "-I" + WIRE_SRC, "-o", exe,
            os.path.join(HERE, "wire_test.c"), os.path.join(WIRE_SRC, "xpra_wire.c")]
    san = ["-fsanitize=address,undefined", "-fno-sanitize-recover=all"]
    r = subprocess.run(base[:1] + san + base[1:], capture_output=True, text=True)
    if r.returncode:
        # a compiler without the sanitizers: the tests still run
        r = subprocess.run(base, capture_output=True, text=True)
    expect(r.returncode == 0, "wire_test does not compile: " + r.stderr[-800:])
    r = subprocess.run([exe], capture_output=True, text=True, timeout=300)
    expect(r.returncode == 0, "wire_test: " + (r.stdout + r.stderr)[-800:])


def test_query(start, ctx):
    """a hello with a request ("xpra version") is answered and the connection closed"""
    srv = start()
    for tcp in (False, True):
        c = srv.client(tcp=tcp)
        c.hello(request="version")
        c.pump(5, lambda c: c.closed)
        expect(c.server is not None, "no hello came back")
        expect(str(c.server.get("version", "")).startswith("6."), "version: %r" % c.server.get("version"))
        expect(c.closed, "the server kept the connection open")
        expect(not c.windows, "a query was sent windows")
    mode = os.stat(srv.socket).st_mode
    expect(mode & 0o077 == 0, "the socket is open to others: mode %o" % (mode & 0o777))


def test_windows(start, ctx):
    """every top level window is announced, with its title, class and size"""
    need("xclock", "xterm")
    srv = start()
    srv.run("xclock", "-geometry", "200x200+50+50", "-name", "tclock")
    srv.run("xterm", "-geometry", "80x24+400+300", "-T", "a terminal", "-e", "sleep", "60")
    time.sleep(1.0)
    c = srv.client()
    c.attach()
    clock, term = c.find(cls="XClock"), c.find(cls="XTerm")
    expect(clock and term, "windows: %r" % list(c.windows.values()))
    expect(len(c.windows) == 2, "windows: %r" % list(c.windows.values()))
    expect((clock.w, clock.h) == (200, 200), "xclock is %dx%d" % (clock.w, clock.h))
    expect(term.title() == "a terminal", "title: %r" % term.title())
    expect(clock.metadata.get("class-instance") == ["tclock", "XClock"],
           "class: %r" % clock.metadata.get("class-instance"))
    expect(clock.metadata.get("window-type") == ["NORMAL"], "type: %r" % clock.metadata.get("window-type"))
    expect(clock.metadata.get("client-machine"), "no client-machine")
    expect("increment" in term.metadata.get("size-constraints", {}), "xterm's size hints are missing")
    expect(not clock.override_redirect, "xclock announced as a popup")
    expect(c.server.get("session_name") == "tightvnc tests", "session name: %r" % c.server.get("session_name"))


def test_pixels(start, ctx):
    """what the client is sent is what is on the screen"""
    need("xclock", "xterm")
    srv = start()
