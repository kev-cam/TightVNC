sys.path.insert(0, HERE)

from xpraproto import XpraClient, RfbViewer, Closed, rfb_grab, compare, rencode, lz4_store  # noqa: E402

TOP = os.path.dirname(HERE)
DEFAULT_XVNC = os.path.join(TOP, "Xvnc", "programs", "Xserver", "Xvnc")
WIRE_SRC = os.path.join(TOP, "Xvnc", "programs", "Xserver", "hw", "vnc")

FONT_DIRS = [
    "/usr/share/fonts/X11/misc", "/usr/share/fonts/X11/75dpi", "/usr/share/fonts/X11/100dpi",
    "/usr/share/X11/fonts/misc", "/usr/X11R6/lib/X11/fonts/misc", "/usr/lib/X11/fonts/misc",
]
RGB_FILES = ["/usr/share/X11/rgb", "/etc/X11/rgb", "/usr/X11R6/lib/X11/rgb", "/usr/lib/X11/rgb"]


class Skip(Exception):
    pass


def need(*programs):
    for p in programs:
        if not shutil.which(p):
            raise Skip("%s is not installed" % p)


def expect(cond, what):
    if not cond:
        raise AssertionError(what)


def wait_for(cond, seconds, step=0.05):
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        v = cond()
        if v:
            return v
        time.sleep(step)
    return cond()


def free_port():
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    return port


def free_display():
    for n in random.sample(range(100, 400), 300):
        if not os.path.exists("/tmp/.X11-unix/X%d" % n) and not os.path.exists("/tmp/.X%d-lock" % n):
            return n
    raise RuntimeError("no free display number")


class Server:
    """An Xvnc on a display of its own, and the programs run on it."""

    def __init__(self, xvnc, workdir, geometry="1400x1000", verbose=False, args=(), rgb=True):
        self.dir = workdir
        self.display = free_display()
        self.rfb_port = free_port()
        self.xpra_port = free_port()
        self.socket = os.path.join(workdir, "xpra.sock")
        self.auth = os.path.join(workdir, "Xauthority")
        self.log = os.path.join(workdir, "xvnc.log")
        self.apps = []
        # one cookie, for any display (family "wild", no address, no number)
        with open(self.auth, "wb") as f:
            name = b"MIT-MAGIC-COOKIE-1"
            f.write(struct.pack("!HHH", 0xffff, 0, 0) + struct.pack("!H", len(name)) + name +
                    struct.pack("!H", 16) + os.urandom(16))
        os.chmod(self.auth, 0o600)
        fonts = ",".join(d + "/" for d in FONT_DIRS if os.path.isdir(d))
        if not fonts:
            raise Skip("no X fonts found (xfonts-base)")
        colours = rgb
        rgb = next((r for r in RGB_FILES if os.path.exists(r + ".txt")), None)
        cmd = [xvnc, ":%d" % self.display, "-auth", self.auth, "-nolisten", "tcp", "-localhost",
               "-geometry", geometry, "-depth", "24", "-rfbport", str(self.rfb_port),
               "-desktop", "tightvnc tests", "-fp", fonts,
               "-xprasocket", self.socket, "-xpraport", str(self.xpra_port)]
        if rgb and colours:
            cmd += ["-co", rgb]
        cmd += list(args)
        self.logfile = open(self.log, "wb")
        self.proc = subprocess.Popen(cmd, stdout=self.logfile, stderr=subprocess.STDOUT,
                                     stdin=subprocess.DEVNULL, cwd=workdir)
        self.verbose = verbose
        if not wait_for(lambda: os.path.exists(self.socket) and
                        os.path.exists("/tmp/.X11-unix/X%d" % self.display) or
                        self.proc.poll() is not None, 10):
            raise AssertionError("the server did not start: " + self.tail())
        if self.proc.poll() is not None:
            raise AssertionError("the server exited at once: " + self.tail())

    def env(self):
        e = dict(os.environ)
        e["DISPLAY"] = ":%d" % self.display
        e["XAUTHORITY"] = self.auth
        e.pop("WAYLAND_DISPLAY", None)
        return e

    def run(self, *argv, **kw):
        p = subprocess.Popen(list(argv), env=self.env(), stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             cwd=self.dir, start_new_session=True, **kw)
        self.apps.append(p)
        return p

    def output(self, *argv):
        return subprocess.run(list(argv), env=self.env(), stdin=subprocess.DEVNULL,
                              capture_output=True, text=True, timeout=20).stdout

    def geometry(self, xid):
        """(x, y, w, h) of a window's inside, on the screen; None without xwininfo."""
        if not shutil.which("xwininfo"):
            return None
        vals = {}
        for line in self.output("xwininfo", "-id", str(xid)).splitlines():
            if ":" in line:
                k, v = line.split(":", 1)
                vals[k.strip()] = v.strip()
        try:
            # xwininfo's corner is the border's: the inside starts a border in
            bw = int(vals.get("Border width", "0"))
            return (int(vals["Absolute upper-left X"]) + bw, int(vals["Absolute upper-left Y"]) + bw,
                    int(vals["Width"]), int(vals["Height"]))
        except (KeyError, ValueError):
            return None

    def alive(self):
        return self.proc.poll() is None

    def tail(self, n=15):
        if not self.logfile.closed:
            self.logfile.flush()
        try:
            with open(self.log, "r", errors="replace") as f:
                return "".join(f.readlines()[-n:])
        except OSError:
            return ""

    def client(self, tcp=False, **kw):
        return XpraClient(("127.0.0.1", self.xpra_port) if tcp else self.socket, **kw)

    def stop(self):
        for p in self.apps:
            if p.poll() is None:
                try:
                    os.killpg(p.pid, signal.SIGTERM)
                except OSError:
                    pass
        if self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(5)
            except subprocess.TimeoutExpired:
                self.proc.kill()
                self.proc.wait()
        for p in self.apps:
            try:
                p.wait(2)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(p.pid, signal.SIGKILL)
                except OSError:
                    pass
        self.logfile.close()
        if self.verbose:
            sys.stdout.write(self.tail(200))


def pixels_agree(srv, client, wins=None, tries=4):
    """The windows as the Xpra client has them are what RFB says is on the
    screen, at the place the X server has each window."""
    last = None
    for _ in range(tries):
        client.settle()
        fb = rfb_grab(srv.rfb_port)
        client.settle(quiet=0.2)
        last = []
        for win in (wins if wins is not None else list(client.windows.values())):
            if win.wid not in client.windows:
                continue
            geo = srv.geometry(win.metadata.get("xid", 0))
            origin = (geo[0], geo[1]) if geo else None
            if geo and (geo[2], geo[3]) != (win.w, win.h):
                last.append("%r: the server has it at %dx%d" % (win, geo[2], geo[3]))
                continue
            bad = compare(win, fb, origin)
            if bad:
                last.append("%r: differs from the screen at %s%s" % (
                    win, bad[:4], " and more" if len(bad) > 4 else ""))
        if not last:
            return
        time.sleep(0.3)
    raise AssertionError("; ".join(last))


