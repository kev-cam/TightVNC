def test_bad_input(start, ctx):
    """nothing a client sends stops the server"""
    need("xclock")
    srv = start()
    srv.run("xclock")
    time.sleep(0.8)
    rnd = random.Random(1)

    def blast(data, hello=False):
        c = srv.client(tcp=rnd.random() < 0.5)
        try:
            if hello:
                c.attach()
            c.send_bytes(data)
            c.pump(0.15)
        except (Closed, OSError, AssertionError, ValueError):
            pass
        c.close()
        expect(srv.alive(), "the server died of %r...: %s" % (data[:40], srv.tail()))

    def frame(payload, flags=0x10, level=0, index=0, size=None):
        return struct.pack("!BBBBL", 80, flags, level, index, len(payload) if size is None else size) + payload

    blast(b"GET / HTTP/1.0\r\n\r\n")
    blast(b"RFB 003.008\n")
    blast(os.urandom(4096))
    blast(frame(b"", size=0xffffffff))
    blast(frame(b"x" * 100, size=50 * 1024 * 1024))
    blast(frame(rencode(["hello", {}]), flags=0x12))          # "encrypted"
    blast(frame(rencode(["hello", {}]), flags=0x04))          # yaml
    blast(frame(rencode(["hello", {}]), level=0x41))          # brotli
    blast(frame(b"\xff" * 64, level=0x11))                    # not lz4
    blast(frame(struct.pack("<I", 0x7fffffff) + b"\x00", level=0x11))
    blast(frame(lz4_store(rencode(["hello", {}]))[:-3], level=0x11))
    blast(frame(rencode("hello")))                            # not a list
    blast(frame(rencode([])))
    blast(frame(rencode([5, 6])))
    blast(frame(rencode(["hello"])))
    blast(frame(rencode(["hello", "caps"])))
    blast(frame(b"\xc1" * 200))                               # nested too deep
    blast(frame(b"\x3b" * 3))                                 # lists never closed
    for i in range(1, 16):                                    # raw chunks and nothing else
        blast(b"".join(frame(b"z" * 10, index=i) for _ in range(3)))
    blast(frame(b"z", index=200))
    blast(frame(rencode(["hello", {"compressors": 7, "encoders": "x", "lz4": [1], "rencodeplus": None,
                                   "request": ["a"]}])))
    for _ in range(40):
        good = bytearray(frame(lz4_store(rencode(["hello", {"version": "6.5", "rencodeplus": True,
                                                              "compressors": ["lz4"]}])), level=0x11))
        for _ in range(rnd.randrange(1, 5)):
            good[rnd.randrange(len(good))] = rnd.randrange(256)
        blast(bytes(good))

    # and from a client that is attached: every packet with the wrong things in it
    junk = [None, True, -1, 0, 7, 2 ** 40, -2 ** 40, 1.5, "", "x" * 300, b"\x00\xff", [], [1, 2],
            ["a", "b", "c", "d"], [-5, -5, 100000, 100000], {}, {"a": [1]}, [[[[[]]]]]]
    types = ["hello", "ping", "ping_echo", "damage-sequence", "pointer", "pointer-button",
             "pointer-position", "button-action", "key-action", "focus", "map-window",
             "configure-window", "unmap-window", "close-window", "buffer-refresh", "disconnect",
             "connection-lost", "shutdown-server", "exit-server", "desktop_size", "set_deflate",
             "keymap-changed", "clipboard-token", "info-request", "wheel-motion", "no-such-packet", ""]
    for t in types:
        data = b""
        for _ in range(12):
            wid = rnd.choice([1, 1, 1, 2, 0, -1, 99999])
            args = [rnd.choice(junk + [wid]) for _ in range(rnd.randrange(0, 14))]
            if rnd.random() < 0.6:
                args[:0] = [wid]
            data += frame(rencode([t] + args))
        blast(data, hello=True)
    # sizes and places no window should take
    c = srv.client()
    c.attach()
    win = c.find(cls="XClock")
    expect(win, "after all that, no xclock window: %s" % srv.tail())
    for w, h in ((0, 0), (-10, 5), (70000, 70000), (1, 1), (2 ** 33, 3), (200, 200)):
        c.configure(win, -30000, 40000, w, h)
        c.send("map-window", win.wid, 0, 0, w, h, {}, {})
        c.pointer(win, w, h)
        c.pointer(win, -w - 1, -99999)
    c.send("pointer", 0, 0, win.wid, [1, 2, 3], {})
    c.send("pointer", 0, 0, win.wid, [], {})
    c.send("key-action", win.wid, "x", True, [], 0x7fffffff, "", 0, 0)
    c.send("key-action", win.wid, "x", True, [], -4, "", 0, 0)
    c.send("draw", win.wid, 0, 0, 1, 1, "rgb24", b"1234", 1, 4, {}, chunk=7)
    c.settle()
    expect(srv.alive(), "the server died: " + srv.tail())
    c.close()

    # the server is still good for what it is for
    c = srv.client()
    c.attach()
    expect(c.find(cls="XClock"), "no xclock window at the end: %s" % srv.tail())
    c.configure(c.find(cls="XClock"), 0, 0, 200, 200)
    c.find(cls="XClock").resize(200, 200)
    pixels_agree(srv, c)


def test_server_reset(start, ctx):
    """when the last X program exits the X server resets: clients stay"""
    need("xclock", "xterm")
