def test_wire_format(start, ctx):
    """xpra_wire.c on its own: known answers, round trips, damaged input"""
    cc = shutil.which("cc") or shutil.which("gcc")
    if not cc:
        raise Skip("no C compiler")
    exe = os.path.join(ctx.dir, "wire_test")
    base = [cc, "-std=gnu90", "-Wall", "-g", "-O1", "-I" + WIRE_SRC, "-o", exe,
            os.path.join(HERE, "wire_test.c"), os.path.join(WIRE_SRC, "xpra_wire.c")]
    san = ["-fsanitize=address,undefined", "-fno-sanitize-recover=all"]
    r = subprocess.run(base[:1] + san + base[1:], capture_output=True, text=True)
    if r.returncode:
        # a compiler without the sanitizers: the tests still run
        r = subprocess.run(base, capture_output=True, text=True)
    expect(r.returncode == 0, "wire_test does not compile: " + r.stderr[-800:])
    r = subprocess.run([exe], capture_output=True, text=True, timeout=300)
    expect(r.returncode == 0, "wire_test: " + (r.stdout + r.stderr)[-800:])


def test_query(start, ctx):
    """a hello with a request ("xpra version") is answered and the connection closed"""
    srv = start()
    for tcp in (False, True):
        c = srv.client(tcp=tcp)
        c.hello(request="version")
        c.pump(5, lambda c: c.closed)
        expect(c.server is not None, "no hello came back")
        expect(str(c.server.get("version", "")).startswith("6."), "version: %r" % c.server.get("version"))
        expect(c.closed, "the server kept the connection open")
        expect(not c.windows, "a query was sent windows")
    mode = os.stat(srv.socket).st_mode
    expect(mode & 0o077 == 0, "the socket is open to others: mode %o" % (mode & 0o777))


def test_windows(start, ctx):
    """every top level window is announced, with its title, class and size"""
    need("xclock", "xterm")
    srv = start()
    srv.run("xclock", "-geometry", "200x200+50+50", "-name", "tclock")
    srv.run("xterm", "-geometry", "80x24+400+300", "-T", "a terminal", "-e", "sleep", "60")
    time.sleep(1.0)
    c = srv.client()
    c.attach()
    clock, term = c.find(cls="XClock"), c.find(cls="XTerm")
    expect(clock and term, "windows: %r" % list(c.windows.values()))
    expect(len(c.windows) == 2, "windows: %r" % list(c.windows.values()))
    expect((clock.w, clock.h) == (200, 200), "xclock is %dx%d" % (clock.w, clock.h))
    expect(term.title() == "a terminal", "title: %r" % term.title())
    expect(clock.metadata.get("class-instance") == ["tclock", "XClock"],
           "class: %r" % clock.metadata.get("class-instance"))
    expect(clock.metadata.get("window-type") == ["NORMAL"], "type: %r" % clock.metadata.get("window-type"))
    expect(clock.metadata.get("client-machine"), "no client-machine")
    expect("increment" in term.metadata.get("size-constraints", {}), "xterm's size hints are missing")
    expect(not clock.override_redirect, "xclock announced as a popup")
    expect(c.server.get("session_name") == "tightvnc tests", "session name: %r" % c.server.get("session_name"))


def test_pixels(start, ctx):
    """what the client is sent is what is on the screen"""
    need("xclock", "xterm")
    srv = start()
    srv.run("xclock", "-geometry", "200x200+50+50")
    srv.run("xterm", "-geometry", "80x24+400+300", "-e", "sh", "-c", "ls -la /; sleep 60")
    time.sleep(1.0)
    c = srv.client()
    c.attach()
    expect(len(c.windows) == 2, "windows: %r" % list(c.windows.values()))
    pixels_agree(srv, c)


def test_placement(start, ctx):
    """without a window manager, windows that overlap are moved apart"""
    need("xclock", "xterm", "xwininfo")
    srv = start()
    srv.run("xterm", "-geometry", "80x24+40+40", "-e", "sleep", "60")
    srv.run("xclock", "-geometry", "200x200+100+100")
    srv.run("xterm", "-geometry", "60x10+60+60", "-e", "sleep", "60")
    # one that hangs off the screen
    srv.run("xclock", "-geometry", "150x150+1350+950")
    time.sleep(1.2)
    c = srv.client()
    c.attach()
    expect(len(c.windows) == 4, "windows: %r" % list(c.windows.values()))
    boxes = []
    for win in c.windows.values():
        geo = srv.geometry(win.metadata["xid"])
        expect(geo, "no geometry for %r" % win)
        x, y, w, h = geo
        expect(x >= 0 and y >= 0 and x + w <= 1400 and y + h <= 1000, "%r is off the screen: %r" % (win, geo))
        boxes.append((win, x, y, x + w, y + h))
    for i, (wa, ax1, ay1, ax2, ay2) in enumerate(boxes):
        for wb, bx1, by1, bx2, by2 in boxes[i + 1:]:
            expect(not (ax1 < bx2 and ax2 > bx1 and ay1 < by2 and ay2 > by1),
                   "%r and %r overlap" % (wa, wb))
    pixels_agree(srv, c)


def test_typing(start, ctx):
    """keys typed in a window reach the program in it"""
    need("xterm")
    srv = start()
    out = os.path.join(ctx.dir, "typed.txt")
    app = srv.run("xterm", "-e", "sh", "-c", "cat > '%s'" % out)
    c = srv.client()
    c.attach()
    win = wait_for(lambda: c.pump(0.2) and c.find(cls="XTerm"), 5)
    expect(win, "no xterm window")
    c.focus(win)
    c.pointer(win, 50, 50)
    text = "hello xpra 123\n"
    c.type(win, text)
    # with the shift key, as a client sends capitals
    c.key(win, 0xffe1, True, "Shift_L")
    c.key(win, ord("A"), True, "A")
    c.key(win, ord("A"), False, "A")
    c.key(win, 0xffe1, False, "Shift_L")
    c.type(win, "\n\x04")
    wait_for(lambda: c.pump(0.2) and app.poll() is not None, 8)
    expect(app.poll() is not None, "xterm did not exit on control-d")
    got = open(out).read()
    expect(got == text + "A\n", "typed %r, the program got %r" % (text + "A\n", got))
    expect(c.find(cls="XTerm") is None, "the closed window was not taken back")


def test_click(start, ctx):
    """a click in a window reaches the button under it"""
    need("xmessage", "xwininfo")
    srv = start()
    app = srv.run("xmessage", "-buttons", "first:11,second:12", "pick one")
    c = srv.client()
    c.attach()
    win = wait_for(lambda: c.pump(0.2) and c.find(cls="Xmessage"), 5)
    expect(win, "no xmessage window")
    # the buttons are child windows: find the second one
    tree = srv.output("xwininfo", "-id", str(win.metadata["xid"]), "-tree")
    kids = []
    for line in tree.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0].startswith("0x") and "+" in parts[-1] and "x" in parts[-2]:
            size, _, rest = parts[-2].partition("+")
            w, h = (int(v) for v in size.split("x"))
            ax, ay = (int(v) for v in parts[-1].lstrip("+").split("+"))
            kids.append((w, h, ax, ay))
    geo = srv.geometry(win.metadata["xid"])
    buttons = sorted((k for k in kids if 10 < k[0] < 120 and 10 < k[1] < 40 and k[3] > geo[1] + 20),
                     key=lambda k: k[2])
    expect(len(buttons) >= 2, "could not find the buttons in:\n" + tree)
    w, h, ax, ay = buttons[1]
    c.click(win, ax - geo[0] + w // 2, ay - geo[1] + h // 2)
    wait_for(lambda: c.pump(0.2) and app.poll() is not None, 6)
    expect(app.poll() == 12, "xmessage exit status %r, not that of the second button" % app.poll())


def test_popup(start, ctx):
    """a menu is a window of its own, placed against the window it belongs to"""
    need("xterm", "xwininfo")
    srv = start()
    srv.run("xterm", "-geometry", "80x24+300+200", "-e", "sleep", "60")
    c = srv.client()
    c.attach()
    win = wait_for(lambda: c.pump(0.2) and c.find(cls="XTerm"), 5)
    expect(win, "no xterm window")
    c.focus(win)
    c.pointer(win, 200, 100)
    c.key(win, 0xffe3, True, "Control_L")
    c.button(win, 1, True, 200, 100)
    menu = wait_for(lambda: c.pump(0.2) and c.find(popup=True), 5)
    expect(menu, "no menu appeared")
    c.settle()
    meta = menu.metadata
    expect(meta.get("parent") == win.wid, "the menu's parent is %r, not the xterm" % meta.get("parent"))
    geo, pgeo = srv.geometry(meta["xid"]), srv.geometry(win.metadata["xid"])
    expect(meta.get("relative-position") == [geo[0] - pgeo[0], geo[1] - pgeo[1]],
           "relative position %r, on the screen it is %r" % (meta.get("relative-position"),
                                                             [geo[0] - pgeo[0], geo[1] - pgeo[1]]))
    # this client has the xterm where the server has it, so the menu too
    expect((menu.x, menu.y) == (geo[0], geo[1]), "menu sent to %r, it is at %r" % ((menu.x, menu.y), geo[:2]))
    # the menu lies over the xterm: only the menu can be compared for now
    pixels_agree(srv, c, [menu])
    c.button(win, 1, False, 20, 20)
    c.key(win, 0xffe3, False, "Control_L")
    wait_for(lambda: c.pump(0.2) and c.find(popup=True) is None, 5)
    expect(c.find(popup=True) is None, "the menu stayed after the button was released")
    # what the menu covered has been repainted, and sent
    pixels_agree(srv, c)


def test_popup_follows_client(start, ctx):
    """a client that has moved a window gets its menus where it has the window"""
    need("xterm", "xwininfo")
    srv = start()
    srv.run("xterm", "-geometry", "80x24+300+200", "-e", "sleep", "60")
    c = srv.client(automap=False)
    c.attach()
    win = c.find(cls="XTerm")
    expect(win, "no xterm window")
    c.map_window(win, 1000, 700)        # where this client shows it
    c.settle()
    c.pointer(win, 200, 100)
    c.key(win, 0xffe3, True, "Control_L")
    c.button(win, 1, True, 200, 100)
    menu = wait_for(lambda: c.pump(0.2) and c.find(popup=True), 5)
    expect(menu, "no menu appeared")
    geo, pgeo = srv.geometry(menu.metadata["xid"]), srv.geometry(win.metadata["xid"])
    want = (1000 + geo[0] - pgeo[0], 700 + geo[1] - pgeo[1])
    expect((menu.x, menu.y) == want, "menu sent to %r, should be %r" % ((menu.x, menu.y), want))
    c.button(win, 1, False, 20, 20)
    c.key(win, 0xffe3, False, "Control_L")


def test_resize(start, ctx):
    """a window resized by the client is resized on the server, and redrawn"""
    need("xterm", "xwininfo")
    srv = start()
    srv.run("xterm", "-geometry", "80x24+100+100", "-e", "sh", "-c", "ls -la /usr; sleep 60")
    c = srv.client()
    c.attach()
    win = c.find(cls="XTerm")
    expect(win, "no xterm window")
    # a whole number of character cells more: the xterm takes it as it is
    w, h = win.w + 120, win.h + 78
    c.configure(win, 0, 0, w, h)
    win.resize(w, h)
    wait_for(lambda: c.pump(0.2) and srv.geometry(win.metadata["xid"])[2:] == (w, h), 5)
    expect(srv.geometry(win.metadata["xid"])[2:] == (w, h),
           "asked for %dx%d, the server has %r" % (w, h, srv.geometry(win.metadata["xid"])[2:]))
    pixels_agree(srv, c)
    # not a whole number of cells: the client is told the size it got
    c.configure(win, 0, 0, w + 5, h + 5)
    win.resize(w + 5, h + 5)
    wait_for(lambda: c.pump(0.2) and any(p[0] == "window-resized" for p in c.packets), 5)
    geo = srv.geometry(win.metadata["xid"])
    expect((win.w, win.h) == (geo[2], geo[3]),
           "the client was left at %dx%d, the window is %dx%d" % (win.w, win.h, geo[2], geo[3]))
    pixels_agree(srv, c)


def test_cursor(start, ctx):
    """the pointer's shape follows what it is over"""
    need("xterm", "xclock")
    srv = start()
    srv.run("xterm", "-geometry", "80x24+50+50", "-e", "sleep", "60")
    srv.run("xclock", "-geometry", "200x200+700+50")
    time.sleep(1.0)
    c = srv.client()
    c.attach()
    term, clock = c.find(cls="XTerm"), c.find(cls="XClock")
    expect(term and clock, "windows: %r" % list(c.windows.values()))
    c.pointer(term, 100, 100)
    wait_for(lambda: c.pump(0.2) and isinstance(c.cursor, list), 4)
    cur = c.cursor
    expect(isinstance(cur, list), "no pointer shape over the xterm: %r" % (cur,))
    encoding, x, y, w, h, xhot, yhot, serial, pixels = cur[:9]
    expect(encoding == "raw", "encoding %r" % encoding)
    expect(0 < w <= 64 and 0 < h <= 64 and len(pixels) == w * h * 4,
           "%dx%d cursor with %d bytes" % (w, h, len(pixels)))
    expect(0 <= xhot < w and 0 <= yhot < h, "hot spot %d,%d in %dx%d" % (xhot, yhot, w, h))
    alphas = set(pixels[3::4])
    expect(alphas == {0, 255}, "a text cursor is part opaque, part clear: alphas %r" % sorted(alphas))
    # the xterm's is an I beam: taller than wide, a black stem outlined in white
    opaque = {bytes(pixels[i:i + 3]) for i in range(0, len(pixels), 4) if pixels[i + 3]}
    expect(h > w and opaque == {b"\x00\x00\x00", b"\xff\xff\xff"},
           "%dx%d in colours %r does not look like xterm's I beam" % (w, h, sorted(opaque)))
    # the clock has no cursor of its own: the root's, for which the client uses its default
    c.pointer(clock, 100, 100)
    wait_for(lambda: c.pump(0.2) and c.cursor == "", 4)
    expect(c.cursor == "", "over the clock the client was not told to use its own pointer: %r" % (c.cursor,))
    c.pointer(term, 50, 50)
    wait_for(lambda: c.pump(0.2) and isinstance(c.cursor, list), 4)
    expect(isinstance(c.cursor, list) and bytes(c.cursor[8]) == bytes(pixels),
           "back over the xterm, not its shape again")


def test_close(start, ctx):
    """closing a window asks its program to close it"""
    need("xclock")
    srv = start()
    app = srv.run("xclock")
    c = srv.client()
    c.attach()
    win = wait_for(lambda: c.pump(0.2) and c.find(cls="XClock"), 5)
    expect(win, "no xclock window")
    c.send("close-window", win.wid)
