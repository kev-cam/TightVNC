    expect(wait_for(lambda: c.pump(0.2) and c.find(cls="XClock"), 5), "no xclock window")
    os.killpg(app.pid, signal.SIGTERM)
    wait_for(lambda: c.pump(0.2) and not c.windows, 6)
    expect(not c.windows, "the window was not taken back")
    time.sleep(1.0)                     # the reset
    expect(srv.alive(), "the server died at its reset: " + srv.tail())
    srv.run("xterm", "-e", "sh", "-c", "echo after the reset; sleep 60")
    expect(wait_for(lambda: c.pump(0.2) and c.find(cls="XTerm"), 6),
           "nothing announced after the reset: " + srv.tail())
    expect(not c.closed, "the client was dropped at the reset")
    pixels_agree(srv, c)
    # and once more, with the client gone in between
    c.close()
    for p in srv.apps:
        if p.poll() is None:
            os.killpg(p.pid, signal.SIGTERM)
    time.sleep(1.5)
    expect(srv.alive(), "the server died at its second reset: " + srv.tail())
    srv.run("xclock")
    time.sleep(0.8)
    c = srv.client()
    c.attach()
